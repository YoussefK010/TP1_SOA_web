<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">
    <xs:simpleType name="noteType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="10"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="genreType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Action"/>
            <xs:enumeration value="Drame"/>
            <xs:enumeration value="Comédie"/>
            <xs:enumeration value="Animation"/>
            <xs:enumeration value="Science-fiction"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="filmType">
        <xs:sequence>
            <xs:element name="titre" type="xs:string"/>
            <xs:element name="realisateur" type="xs:string"/>
            <xs:element name="annee" type="xs:gYear"/>
            <xs:element name="duree" type="xs:positiveInteger"/>
            <xs:element name="note" type="noteType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
        <xs:attribute name="genre" type="genreType" use="required"/>
        <xs:attribute name="disponible" type="xs:boolean" use="required"/>
    </xs:complexType>
    <xs:complexType name="seanceType">
        <xs:sequence>
            <xs:element name="salle" type="xs:string"/>
            <xs:element name="date" type="xs:date"/>
            <xs:element name="heure" type="xs:time"/>
            <xs:element name="prix" type="xs:decimal"/>
        </xs:sequence>
        <xs:attribute name="filmRef" type="xs:IDREF" use="required"/>
    </xs:complexType>
    <xs:element name="cinema">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="films">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="film" type="filmType"
                                        maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="seances">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="seance" type="seanceType"
                                        minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="nom" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
</xs:schema>